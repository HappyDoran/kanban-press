{
  "name": "kanban-press",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.0+sha512.266f8957a30d2be6e9468e5e66bcdedd35a794175f71b067ba8504d686cce1d0c0f429b33c323c3c569ad4891e667574a49ff71d1b89a22cc66f13c65818c578",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=11.15.0 <12"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "check:boundaries": "node tooling/scripts/check-package-boundaries.mjs",
    "dev": "pnpm --recursive --parallel --if-present run dev",
    "lint": "node tooling/scripts/check-package-boundaries.mjs && node tooling/scripts/check-structure.mjs && pnpm --recursive --if-present run lint",
    "structure:check": "node tooling/scripts/check-structure.mjs",
    "test": "node --test tooling/scripts/*.test.mjs && pnpm --recursive --if-present run test",
    "test:e2e": "pnpm --filter @kanban-press/web test:e2e",
    "test:harness": "node --test tooling/scripts/*.test.mjs",
    "test:integration": "pnpm --recursive --if-present run test:integration",
    "typecheck": "pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  }
}
