---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<BaseLayout title="Study Log">
  <section>
    <p class="muted">Personal Knowledge Archive</p>
    <h1>공부한 내용과 기술 지식을 기록하는 공간입니다.</h1>
    <p class="muted">배우고 해결한 내용을 간결하게 정리합니다.</p>
  </section>
  <section style="margin-top:48px">
    {posts.length === 0 ? <p class="muted">아직 게시된 글이 없습니다.</p> : posts.map((post) => (
      <a class="card" href={`${import.meta.env.BASE_URL}posts/${post.id.replace(/\.(md|mdx)$/, '')}/`}>
        <span class="pill">{post.data.category}</span>
        <h2>{post.data.title}</h2>
        <p class="muted">{post.data.description}</p>
        <small class="muted">{post.data.publishedAt.toLocaleDateString('ko-KR')}</small>
      </a>
    ))}
  </section>
</BaseLayout>
