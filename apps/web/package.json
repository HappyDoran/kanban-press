{
  "name": "@kanban-press/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint .",
    "start": "next start",
    "test": "vitest run --exclude 'e2e/**' --exclude '**/*.integration.test.ts' --exclude '**/*.smoke.test.ts'",
    "test:e2e": "playwright test",
    "test:integration": "vitest run lib/server/publish/rollout.integration.test.ts",
    "test:smoke": "vitest run --mode smoke --testTimeout=120000 lib/server/publish/provider.smoke.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@kanban-press/auth": "workspace:*",
    "@kanban-press/domain": "workspace:*",
    "@kanban-press/github": "workspace:*",
    "@kanban-press/notion": "workspace:*",
    "@kanban-press/publisher": "workspace:*",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint-config-next": "^16.2.10",
    "vitest": "^4.1.10"
  }
}
