# GitHub OAuth App
GITHUB_OAUTH_CLIENT_ID=github_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=github_oauth_client_secret
GITHUB_API_VERSION=2026-03-10

# Notion Public Integration
NOTION_OAUTH_CLIENT_ID=notion_oauth_client_id
NOTION_OAUTH_CLIENT_SECRET=notion_oauth_client_secret
NOTION_API_VERSION=2026-03-11

# 32-byte cookie encryption key encoded as base64url.
# 실제 운영에서는 key ID별 secret manager 값을 사용합니다.
COOKIE_ENCRYPTION_KEY_V1=replace_with_32_byte_base64url_key
COOKIE_ACTIVE_KEY_ID=v1

APP_ORIGIN=http://localhost:3000
